rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isOptionalString(value) {
      return value == null || value is string;
    }

    function currentGeneration(uid) {
      return exists(/databases/$(database)/documents/account_progress/$(uid))
        ? get(/databases/$(database)/documents/account_progress/$(uid)).data.generation : 0;
    }

    function validGeneration(uid, data) {
      return data.get('generation', 0) == currentGeneration(uid) &&
        (!exists(/databases/$(database)/documents/account_progress/$(uid)) ||
          !get(/databases/$(database)/documents/account_progress/$(uid)).data.resetPending);
    }

    function isSessionShape(data) {
      return data.keys().hasOnly([
            'activeDeviceId',
            'generation',
            'activeEmail',
            'activeDisplayName',
            'status',
            'pendingTransferId',
            'updatedAt',
          ]) &&
          isNonEmptyString(data.activeDeviceId) &&
          ['active', 'transfer_pending'].hasAny([data.status]) &&
          isOptionalString(data.activeEmail) &&
          isOptionalString(data.activeDisplayName) &&
          (data.pendingTransferId == null || isNonEmptyString(data.pendingTransferId)) &&
          data.updatedAt is timestamp;
    }

    function isTransferShape(data) {
      return data.keys().hasOnly([
            'uid',
            'generation',
            'sourceDeviceId',
            'status',
            'createdAt',
            'targetDeviceId',
            'consumedAt',
            'cancelledAt',
          ]) &&
          isNonEmptyString(data.uid) &&
          isNonEmptyString(data.sourceDeviceId) &&
          ['open', 'consumed', 'cancelled'].hasAny([data.status]) &&
          data.createdAt is timestamp &&
          (data.targetDeviceId == null || isNonEmptyString(data.targetDeviceId)) &&
          (data.consumedAt == null || data.consumedAt is timestamp) &&
          (data.cancelledAt == null || data.cancelledAt is timestamp);
    }

    function isValidSessionWrite(userId) {
      return isOwner(userId) &&
          validGeneration(userId, request.resource.data) &&
          isSessionShape(request.resource.data) &&
          (
            !exists(/databases/$(database)/documents/account_sessions/$(userId)) ||
            resource.data == null ||
            request.resource.data.status in ['active', 'transfer_pending']
          );
    }

    function isCloudSaveShape(data) {
      return data.keys().hasOnly([
            'uid',
            'sourceDeviceId',
            'saveCode',
            'generation',
            'revision',
            'updatedAt',
          ]) &&
          isNonEmptyString(data.uid) &&
          isNonEmptyString(data.sourceDeviceId) &&
          isNonEmptyString(data.saveCode) &&
          data.revision is int &&
          data.revision >= 1 &&
          data.updatedAt is timestamp;
    }

    function isValidCloudSaveWrite(userId) {
      return isOwner(userId) &&
          request.resource.data.uid == userId &&
          validGeneration(userId, request.resource.data) &&
          request.resource.data.sourceDeviceId == get(/databases/$(database)/documents/account_sessions/$(userId)).data.activeDeviceId &&
          isCloudSaveShape(request.resource.data);
    }

    function isValidTransferCreate() {
      return isSignedIn() &&
          isTransferShape(request.resource.data) &&
          validGeneration(request.auth.uid, request.resource.data) &&
          request.resource.data.sourceDeviceId == get(/databases/$(database)/documents/account_sessions/$(request.auth.uid)).data.activeDeviceId &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.status == 'open' &&
          request.resource.data.targetDeviceId == null &&
          request.resource.data.consumedAt == null &&
          request.resource.data.cancelledAt == null;
    }

    function isValidTransferUpdate() {
      return isSignedIn() &&
          resource.data.uid == request.auth.uid &&
          validGeneration(request.auth.uid, resource.data) &&
          request.resource.data.get('generation', 0) == resource.data.get('generation', 0) &&
          request.resource.data.uid == request.auth.uid &&
          isTransferShape(request.resource.data) &&
          (
            (
              resource.data.status == 'open' &&
              request.resource.data.status == 'consumed' &&
              isNonEmptyString(request.resource.data.targetDeviceId) &&
              request.resource.data.consumedAt is timestamp &&
              request.resource.data.cancelledAt == null
            ) ||
            (
              resource.data.status == 'open' &&
              request.resource.data.status == 'cancelled' &&
              request.resource.data.targetDeviceId == null &&
              request.resource.data.consumedAt == null &&
              request.resource.data.cancelledAt is timestamp
            )
          );
    }

    match /account_sessions/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isValidSessionWrite(userId);
      allow delete: if false;
    }

    match /account_progress/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
      match /resets/{operationId} {
        allow read, write: if false;
      }
    }

    match /account_transfers/{transferId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isValidTransferCreate();
      allow update: if isValidTransferUpdate();
      allow delete: if false;
    }

    // Purchase entitlements are written only by the redeemPurchase Cloud
    // Function via the Admin SDK, which bypasses these rules. Clients read
    // their own entitlement to reconcile purchased gold; they never write it.
    match /entitlements/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // The purchase ledger is server-only in both directions. Nothing the client
    // could learn from it is worth the risk of it learning another account's
    // transaction ids.
    match /purchases/{purchaseId} {
      allow read, write: if false;
    }

    match /account_cloud_saves/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isValidCloudSaveWrite(userId);
      allow delete: if false;
    }

    // Website waitlist (alchemons-web/js/waitlist.js). Entries are keyed by a
    // SHA-256 of the normalised email, so a repeat signup updates in place.
    // Clients can add or update their own entry but never read or list them.
    match /waitlist/{entryId} {
      allow read, delete: if false;
      allow create, update: if entryId.matches('^[a-f0-9]{64}$') &&
          request.resource.data.keys().hasOnly(['email', 'platform', 'source', 'createdAt']) &&
          request.resource.data.email is string &&
          request.resource.data.email.size() <= 254 &&
          request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
          request.resource.data.platform in ['ios', 'android', 'both'] &&
          request.resource.data.source == 'site' &&
          request.resource.data.createdAt == request.time &&
          (resource == null || resource.data.email == request.resource.data.email);
    }

    // ── Friends (lib/services/friend_service.dart) ──────────────────────────
    //
    // A player's planet (players/{uid}) and home (homes/{uid}) are read only
    // by themselves and their friends. Friendship is two documents, one in
    // each player's friends, written together when one accepts the other's
    // request; either side can delete both. A request can't be sent to
    // someone who blocked the sender or is already their friend.

    function isFriendOf(uid) {
      return isSignedIn() &&
          exists(/databases/$(database)/documents/players/$(uid)/friends/$(request.auth.uid));
    }

    function isFriendCode(code) {
      return code is string && code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ2-9]{8}$');
    }

    function requestExists(from, to) {
      return exists(/databases/$(database)/documents/friend_requests/$(from + '_' + to));
    }

    // Code → owner. Anyone signed in can look one code up; no one can list
    // them. A code is only ever created (a taken one refuses), never moved.
    match /friend_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() &&
          isFriendCode(code) &&
          request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /players/{uid} {
      allow read: if isOwner(uid) || isFriendOf(uid);
      allow create, update: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['name', 'faction', 'code', 'planet', 'title', 'featured', 'trials', 'updatedAt']) &&
          request.resource.data.name is string &&
          request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 40 &&
          isOptionalString(request.resource.data.faction) &&
          isFriendCode(request.resource.data.code) &&
          (request.resource.data.planet == null || request.resource.data.planet is map) &&
          // The title worn and the featured Alchemon's looks: optional, so
          // a build from before them still writes (read with get()).
          isOptionalString(request.resource.data.get('title', null)) &&
          (request.resource.data.get('title', null) == null ||
           request.resource.data.title.size() <= 40) &&
          (request.resource.data.get('featured', null) == null ||
           request.resource.data.featured is map) &&
          // The Trials: cups won and records (friend_home.dart TrialsCard).
          (request.resource.data.get('trials', null) == null ||
           (request.resource.data.trials is map &&
            request.resource.data.trials.keys().hasOnly(['won', 'best']) &&
            request.resource.data.trials.get('won', {}) is map &&
            request.resource.data.trials.get('won', {}).size() <= 16 &&
            request.resource.data.trials.get('best', {}) is map &&
            request.resource.data.trials.get('best', {}).size() <= 48)) &&
          request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);

      match /friends/{other} {
        allow read: if isOwner(uid);
        // Accepting writes both sides: the one accepting may write into
        // their own list and into the asker's, while the request stands.
        allow create, update: if isSignedIn() &&
            uid != other &&
            request.resource.data.keys().hasOnly(['since']) &&
            request.resource.data.since == request.time &&
            ((request.auth.uid == uid && requestExists(other, uid)) ||
             (request.auth.uid == other && requestExists(uid, other)));
        allow delete: if isSignedIn() &&
            (request.auth.uid == uid || request.auth.uid == other);
      }

      match /blocked/{other} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) &&
            request.resource.data.keys().hasOnly(['at']) &&
            request.resource.data.at == request.time;
      }
    }

    match /homes/{uid} {
      allow read: if isOwner(uid) || isFriendOf(uid);
      allow create, update: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['v', 'home', 'updatedAt']) &&
          request.resource.data.v is int &&
          request.resource.data.home is string &&
          request.resource.data.home.size() <= 300000 &&
          request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // When the player was last in the game (away: gone to the background),
    // for the dot by their name on friends' lists.
    match /presence/{uid} {
      allow read: if isOwner(uid) || isFriendOf(uid);
      allow create, update: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['at', 'away']) &&
          request.resource.data.at == request.time &&
          request.resource.data.away is bool;
      allow delete: if isOwner(uid);
    }

    // {from}_{to}. Read by either side; deleted by either (declined,
    // withdrawn, or accepted).
    match /friend_requests/{requestId} {
      allow read: if isSignedIn() &&
          (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if isSignedIn() &&
          request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'fromFaction', 'toCode', 'createdAt']) &&
          request.resource.data.from == request.auth.uid &&
          isNonEmptyString(request.resource.data.to) &&
          request.resource.data.to != request.auth.uid &&
          requestId == request.auth.uid + '_' + request.resource.data.to &&
          request.resource.data.fromName is string &&
          request.resource.data.fromName.size() > 0 &&
          request.resource.data.fromName.size() <= 40 &&
          isOptionalString(request.resource.data.fromFaction) &&
          (request.resource.data.toCode == null || isFriendCode(request.resource.data.toCode)) &&
          request.resource.data.createdAt == request.time &&
          !exists(/databases/$(database)/documents/players/$(request.resource.data.to)/blocked/$(request.auth.uid)) &&
          !exists(/databases/$(database)/documents/players/$(request.resource.data.to)/friends/$(request.auth.uid));
      allow update: if false;
      allow delete: if isSignedIn() &&
          (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // ── Trades (lib/services/trade_service.dart, lib/models/trade.dart) ────
    //
    // Two friends share one table, trades/{a}_{b} (the uids in order). Each
    // writes only their own side: the Alchemon they put up (aOffer / bOffer)
    // and their confirmation (aReady / bReady). Changing what is up clears
    // both confirmations. The one confirming second marks it done in the same
    // write, while the other's confirmation stands and nothing up changes;
    // done can't be undone. Each side then marks that their game collected it
    // (aClaimed / bClaimed); once both have, either may clear the table for
    // the next trade. Putting up, confirming and finishing need the two to be
    // friends; taking back and collecting do not.
    //
    // A table can fuse instead (mode 'fuse'; a table without one trades).
    // Switching clears every confirmation. A fusion confirms with its own
    // flags (aFuse / bFuse, never aReady / bReady), and the one confirming
    // second ends it 'fused' with the cultivation both get (result) in the
    // same write. Games older than fusions only know 'done', so they never
    // take a fusion for a trade, and can't confirm one.

    function tradeMode(d) {
      return d.get('mode', 'trade');
    }

    function fuseFlag(d, s) {
      return d.get(s + 'Fuse', false);
    }

    function noneConfirmed(d) {
      return !d.aReady && !d.bReady && !fuseFlag(d, 'a') && !fuseFlag(d, 'b');
    }

    function tradeSide(d) {
      return request.auth.uid == d.a ? 'a' : 'b';
    }

    function tradeOther(s) {
      return s == 'a' ? 'b' : 'a';
    }

    function tradePartner(d) {
      return request.auth.uid == d.a ? d.b : d.a;
    }

    function areFriends(other) {
      return exists(/databases/$(database)/documents/players/$(request.auth.uid)/friends/$(other)) &&
          exists(/databases/$(database)/documents/players/$(other)/friends/$(request.auth.uid));
    }

    function isTradeOffer(o) {
      return o == null || (o is map &&
          o.keys().hasOnly(['id', 'card']) &&
          isNonEmptyString(o.id) && o.id.size() <= 80 &&
          o.card is string && o.card.size() <= 120000);
    }

    function isTradeShape(tradeId, d) {
      return d.keys().hasOnly(['a', 'b', 'parties', 'aName', 'bName', 'aOffer', 'bOffer',
            'aReady', 'bReady', 'status', 'aClaimed', 'bClaimed', 'lastBy',
            'updatedAt', 'doneAt', 'mode', 'aFuse', 'bFuse', 'result']) &&
          d.keys().hasAll(['a', 'b', 'parties', 'aName', 'bName', 'aOffer', 'bOffer',
            'aReady', 'bReady', 'status', 'aClaimed', 'bClaimed', 'lastBy',
            'updatedAt', 'doneAt']) &&
          isNonEmptyString(d.a) && isNonEmptyString(d.b) && d.a < d.b &&
          tradeId == d.a + '_' + d.b &&
          d.parties == [d.a, d.b] &&
          request.auth.uid in d.parties &&
          d.aName is string && d.aName.size() <= 40 &&
          d.bName is string && d.bName.size() <= 40 &&
          isTradeOffer(d.aOffer) && isTradeOffer(d.bOffer) &&
          d.aReady is bool && d.bReady is bool &&
          d.aClaimed is bool && d.bClaimed is bool &&
          tradeMode(d) in ['trade', 'fuse'] &&
          fuseFlag(d, 'a') is bool && fuseFlag(d, 'b') is bool &&
          d.status in ['open', 'done', 'fused'] &&
          d.lastBy == request.auth.uid &&
          d.updatedAt == request.time &&
          (d.status != 'open' || (!d.aClaimed && !d.bClaimed && d.doneAt == null)) &&
          (!d.aReady || (d.aOffer != null && d.bOffer != null)) &&
          (!d.bReady || (d.aOffer != null && d.bOffer != null)) &&
          (!fuseFlag(d, 'a') || (d.aOffer != null && d.bOffer != null)) &&
          (!fuseFlag(d, 'b') || (d.aOffer != null && d.bOffer != null)) &&
          // Each confirms its own way, and ends its own way.
          (tradeMode(d) == 'trade'
            ? !fuseFlag(d, 'a') && !fuseFlag(d, 'b') && d.status != 'fused'
            : !d.aReady && !d.bReady && d.status != 'done') &&
          // Only a fused table holds a cultivation.
          (d.status == 'fused'
            ? d.get('result', null) is string && d.result.size() <= 60000
            : d.get('result', null) == null);
    }

    // A fresh table, or one cleared after a trade both sides collected: only
    // the writer's side may hold anything, and nothing is confirmed.
    function isFreshTable(d) {
      let s = tradeSide(d);
      return d.status == 'open' && noneConfirmed(d) &&
          d[tradeOther(s) + 'Offer'] == null &&
          (d[s + 'Offer'] == null || areFriends(tradePartner(d)));
    }

    // Open to open: the writer's own side changes, or what the table does.
    function isTradeTurn(d, r) {
      let s = tradeSide(r);
      let o = tradeOther(s);
      let changed = d[s + 'Offer'] != r[s + 'Offer'] || tradeMode(d) != tradeMode(r);
      let readying = (d[s + 'Ready'] == true && r[s + 'Ready'] == false) ||
          (fuseFlag(d, s) == true && fuseFlag(r, s) == false);
      return r.status == 'open' && d.status == 'open' &&
          d.diff(r).affectedKeys().hasOnly([s + 'Name', s + 'Offer', s + 'Ready',
            o + 'Ready', s + 'Fuse', o + 'Fuse', 'mode', 'lastBy', 'updatedAt']) &&
          (changed
            ? noneConfirmed(d)
            : d[o + 'Ready'] == r[o + 'Ready'] && fuseFlag(d, o) == fuseFlag(r, o)) &&
          (!readying || areFriends(tradePartner(r))) &&
          (!changed || d[s + 'Offer'] == null || areFriends(tradePartner(r)));
    }

    // Open to done: the second confirmation, nothing else changing.
    function isTradeDone(d, r) {
      let s = tradeSide(r);
      let o = tradeOther(s);
      return r.status == 'open' && d.status == 'done' &&
          r[o + 'Ready'] == true &&
          d.aReady == true && d.bReady == true &&
          d.aOffer != null && d.bOffer != null &&
          d.diff(r).affectedKeys().hasOnly(['status', s + 'Ready', s + 'Name',
            'doneAt', 'lastBy', 'updatedAt']) &&
          d.doneAt == request.time &&
          areFriends(tradePartner(r));
    }

    // Open to fused: the second confirmation of a fusion, with what it made.
    function isFuseDone(d, r) {
      let s = tradeSide(r);
      let o = tradeOther(s);
      return r.status == 'open' && d.status == 'fused' &&
          tradeMode(r) == 'fuse' &&
          fuseFlag(r, o) == true &&
          fuseFlag(d, 'a') == true && fuseFlag(d, 'b') == true &&
          d.aOffer != null && d.bOffer != null &&
          d.diff(r).affectedKeys().hasOnly(['status', s + 'Fuse', s + 'Name',
            'result', 'doneAt', 'lastBy', 'updatedAt']) &&
          d.doneAt == request.time &&
          areFriends(tradePartner(r));
    }

    // Done or fused: the writer's game has collected it.
    function isTradeClaim(d, r) {
      let s = tradeSide(r);
      return r.status in ['done', 'fused'] && d.status == r.status &&
          d.diff(r).affectedKeys().hasOnly([s + 'Claimed', 'lastBy', 'updatedAt']) &&
          d[s + 'Claimed'] == true;
    }

    match /trades/{tradeId} {
      // A table not made yet reads as missing to either of its two.
      allow get: if isSignedIn() &&
          (resource == null
            ? tradeId.split('_').hasAny([request.auth.uid])
            : request.auth.uid in resource.data.parties);
      allow list: if isSignedIn() && request.auth.uid in resource.data.parties;
      allow create: if isSignedIn() &&
          isTradeShape(tradeId, request.resource.data) &&
          isFreshTable(request.resource.data);
      allow update: if isSignedIn() &&
          request.auth.uid in resource.data.parties &&
          isTradeShape(tradeId, request.resource.data) &&
          (isTradeTurn(request.resource.data, resource.data) ||
           isTradeDone(request.resource.data, resource.data) ||
           isFuseDone(request.resource.data, resource.data) ||
           isTradeClaim(request.resource.data, resource.data) ||
           (resource.data.status in ['done', 'fused'] && resource.data.aClaimed &&
            resource.data.bClaimed && isFreshTable(request.resource.data)));
      allow delete: if isSignedIn() &&
          request.auth.uid in resource.data.parties &&
          (resource.data.status == 'open' ||
           (resource.data.aClaimed && resource.data.bClaimed));
    }

    // A player's trades this week, and the Alchemons they have traded away
    // (id → when), which a restored save is not allowed to bring back.
    match /traders/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
          request.resource.data.keys().hasOnly(['week', 'used', 'gone', 'updatedAt']) &&
          request.resource.data.week is string &&
          request.resource.data.week.size() <= 12 &&
          request.resource.data.used is int &&
          request.resource.data.used >= 0 &&
          request.resource.data.used <= 1000 &&
          request.resource.data.gone is map &&
          request.resource.data.gone.size() <= 5000 &&
          request.resource.data.updatedAt == request.time;
    }

    // Races with friends (race_room_service.dart). The host makes a room,
    // asks friends into it (only friends), picks the course, starts and
    // closes it; everyone asked writes only their own seat (between races)
    // and their own boost taps (during one).
    function isRaceRoomShape(d) {
      return d.keys().hasOnly(['host', 'invited', 'names', 'cup', 'race',
              'state', 'run', 'seats', 'taps', 'field', 'startAt',
              'createdAt', 'updatedAt']) &&
          d.host is string &&
          d.invited is list && d.invited.size() >= 1 &&
          d.invited.size() <= 6 && d.invited[0] == d.host &&
          d.names is map && d.names.size() <= 6 &&
          d.cup is int && d.cup >= 0 && d.cup <= 2 &&
          d.race is int && d.race >= 0 && d.race <= 2 &&
          d.state in ['lobby', 'racing'] &&
          d.run is int && d.run >= 0 &&
          d.seats is map && d.seats.size() <= 6 &&
          d.taps is map && d.taps.size() <= 6 &&
          d.field is list && d.field.size() <= 6 &&
          (d.startAt == null || d.startAt is int) &&
          d.updatedAt == request.time;
    }

    function isRaceSeat(s) {
      return s is map &&
          s.keys().hasOnly(['player', 'id', 'entrant', 'ratings', 'boosts',
              'look', 'at']) &&
          s.player is string && s.player.size() <= 40 &&
          s.id is string && s.id.size() <= 80 &&
          s.entrant is map && s.entrant.size() <= 20 &&
          s.ratings is map && s.ratings.size() == 4 &&
          s.boosts is int && s.boosts >= 0 && s.boosts <= 6 &&
          s.look is map && s.look.size() <= 12 &&
          s.at == request.time;
    }

    // Each of [list] after the host is one of the asker's friends.
    function raceFriendAt(list, i) {
      return list.size() <= i ||
          exists(/databases/$(database)/documents/players/$(list[i])/friends/$(request.auth.uid));
    }

    function asksOnlyFriends(list) {
      return raceFriendAt(list, 1) && raceFriendAt(list, 2) &&
          raceFriendAt(list, 3) && raceFriendAt(list, 4) &&
          raceFriendAt(list, 5);
    }

    // Only the writer's own entry in [after] (a map) differs from [before].
    function onlyMine(after, before) {
      return after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
    }

    // The writer's seat: written between races only, and whole.
    function mySeatOk(d, r) {
      let me = request.auth.uid;
      return !d.seats.diff(r.seats).affectedKeys().hasAny([me]) ||
          (r.state == 'lobby' && (!(me in d.seats) || isRaceSeat(d.seats[me])));
    }

    // The writer's taps: during a race, for that race.
    function myTapsOk(d, r) {
      let me = request.auth.uid;
      return !d.taps.diff(r.taps).affectedKeys().hasAny([me]) ||
          (r.state == 'racing' && me in d.taps &&
           d.taps[me] is map && d.taps[me].keys().hasOnly(['run', 't']) &&
           d.taps[me].run == r.run &&
           d.taps[me].t is list && d.taps[me].t.size() <= 12);
    }

    match /race_rooms/{roomId} {
      // A room gone reads as missing to anyone (it says nothing).
      allow get: if isSignedIn() &&
          (resource == null || request.auth.uid in resource.data.invited);
      allow list: if isSignedIn() && request.auth.uid in resource.data.invited;
      allow create: if isSignedIn() &&
          isRaceRoomShape(request.resource.data) &&
          request.resource.data.host == request.auth.uid &&
          request.resource.data.state == 'lobby' &&
          request.resource.data.run == 0 &&
          request.resource.data.seats.size() == 0 &&
          request.resource.data.taps.size() == 0 &&
          request.resource.data.createdAt == request.time &&
          asksOnlyFriends(request.resource.data.invited);
      allow update: if isSignedIn() &&
          request.auth.uid in resource.data.invited &&
          isRaceRoomShape(request.resource.data) &&
          request.resource.data.host == resource.data.host &&
          request.resource.data.createdAt == resource.data.createdAt &&
          (
            // Anyone in it: their own seat and taps.
            (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['seats', 'taps', 'updatedAt']) &&
             onlyMine(request.resource.data.seats, resource.data.seats) &&
             onlyMine(request.resource.data.taps, resource.data.taps) &&
             mySeatOk(request.resource.data, resource.data) &&
             myTapsOk(request.resource.data, resource.data)) ||
            // The host: who is asked, the course, starting and ending a
            // race (which clears the taps).
            (request.auth.uid == resource.data.host &&
             request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['invited', 'names', 'cup', 'race', 'state', 'run',
                    'field', 'startAt', 'taps', 'updatedAt']) &&
             (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['taps']) ||
              request.resource.data.taps.size() == 0) &&
             (!request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['invited']) ||
              asksOnlyFriends(request.resource.data.invited)))
          );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.host;
    }

    // Reports about a player, kept for review in the console. Write-only.
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
          request.resource.data.keys().hasOnly(['from', 'about', 'reason', 'createdAt']) &&
          request.resource.data.from == request.auth.uid &&
          isNonEmptyString(request.resource.data.about) &&
          request.resource.data.about != request.auth.uid &&
          request.resource.data.reason in ['name', 'home', 'other'] &&
          request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
