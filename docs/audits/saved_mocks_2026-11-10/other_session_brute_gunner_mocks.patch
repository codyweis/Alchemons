+// MOCK (2026-11-10): brute looks to judge. 0 = the September gem; 1 matte
+// facets backlit by its own light; 2 the same on a finer rock, its heat in
+// pores; 3 the finer rock with two rifts and no halo.
+int debugBruteLook = 0;
+
+double _mockHash(double x) {
+  final s = sin(x * 12.9898) * 43758.5453;
+  return s - s.floorToDouble();
+}
+
+/// Each brute rock split once more, for smooth shading and finer heat.
+final List<FacetMesh> _boulders = [
+  for (var k = 0; k < _bombs.length; k++)
+    () {
+      final m = _bombs[k];
+      final xyz = <double>[...m.v];
+      final mids = <int, int>{};
+      double len(int i) => sqrt(
+        xyz[i * 3] * xyz[i * 3] +
+            xyz[i * 3 + 1] * xyz[i * 3 + 1] +
+            xyz[i * 3 + 2] * xyz[i * 3 + 2],
+      );
+      int mid(int a, int b) {
+        final key = min<int>(a, b) * 100000 + max<int>(a, b);
+        return mids.putIfAbsent(key, () {
+          final i = xyz.length ~/ 3;
+          final mx = (xyz[a * 3] + xyz[b * 3]) / 2;
+          final my = (xyz[a * 3 + 1] + xyz[b * 3 + 1]) / 2;
+          final mz = (xyz[a * 3 + 2] + xyz[b * 3 + 2]) / 2;
+          final ml = sqrt(mx * mx + my * my + mz * mz);
+          final want = (len(a) + len(b)) / 2 *
+              (1 + 0.05 * (2 * _mockHash(k * 31.0 + i * 1.7) - 1));
+          xyz
+            ..add(mx / ml * want)
+            ..add(my / ml * want)
+            ..add(mz / ml * want);
+          return i;
+        });
+      }
+
+      final faces = <List<int>>[];
+      for (final f in m.faces) {
+        final a = mid(f[0], f[1]), b = mid(f[1], f[2]), c = mid(f[2], f[0]);
+        faces
+          ..add([f[0], a, c])
+          ..add([a, f[1], b])
+          ..add([c, b, f[2]])
+          ..add([a, b, c]);
+      }
+      return FacetMesh(xyz, faces);
+    }(),
+];
+
+/// Unit direction of each vertex of [m].
+Float64List _dirsOf(FacetMesh m) {
+  final d = Float64List(m.vertexCount * 3);
+  for (var i = 0; i < m.vertexCount; i++) {
+    final x = m.v[i * 3], y = m.v[i * 3 + 1], z = m.v[i * 3 + 2];
+    final l = sqrt(x * x + y * y + z * z);
+    d[i * 3] = x / l;
+    d[i * 3 + 1] = y / l;
+    d[i * 3 + 2] = z / l;
+  }
+  return d;
+}
+
+final List<Float64List> _boulderDirs = [for (final m in _boulders) _dirsOf(m)];
+final List<Float64List> _bombDirs = [for (final m in _bombs) _dirsOf(m)];
+
+/// Heat in a few soft spots, by direction: veins that do not care how fine
+/// the mesh is.
+final List<Float64List> _boulderSpots = [
+  for (var k = 0; k < _boulders.length; k++)
+    _spots(_boulderDirs[k], k, 0.5),
+];
+final List<Float64List> _bombSpots = [
+  for (var k = 0; k < _bombs.length; k++) _spots(_bombDirs[k], k, 0.55),
+];
+
+Float64List _spots(Float64List dirs, int k, double width) {
+  final n = dirs.length ~/ 3;
+  final heat = Float64List(n);
+  final cw = cos(width);
+  for (var s = 0; s < 4; s++) {
+    final a = 2 * pi * _mockHash(k * 7.0 + s * 3.3);
+    final b = asin(2 * _mockHash(k * 5.0 + s * 9.1) - 1);
+    final sx = cos(a) * cos(b), sy = sin(b), sz = sin(a) * cos(b);
+    for (var i = 0; i < n; i++) {
+      final d = dirs[i * 3] * sx + dirs[i * 3 + 1] * sy + dirs[i * 3 + 2] * sz;
+      final h = ((d - cw) / (1 - cw)).clamp(0.0, 1.0);
+      heat[i] = max(heat[i], h * h * (3 - 2 * h));
+    }
+  }
+  return heat;
+}
+
+/// Tighter, hotter spots on the fine rock.
+final List<Float64List> _boulderPores = [
+  for (var k = 0; k < _boulders.length; k++)
+    _spots(_boulderDirs[k], k, 0.2),
+];
+
+/// Two rifts across the fine rock: arcs of great circles, hot down their
+/// middle.
+final List<Float64List> _boulderRifts = [
+  for (var k = 0; k < _boulders.length; k++)
+    () {
+      final dirs = _boulderDirs[k];
+      final n = dirs.length ~/ 3;
+      final heat = Float64List(n);
+      for (var r = 0; r < 2; r++) {
+        final a = 2 * pi * _mockHash(k * 3.1 + r * 5.7);
+        final b = 0.6 * (2 * _mockHash(k * 8.3 + r * 2.9) - 1);
+        // The rift's plane normal, and its middle on the surface.
+        final ax = cos(a) * cos(b), ay = sin(b), az = sin(a) * cos(b);
+        var cx = -sin(a), cy = 0.0, cz = cos(a);
+        final t = 2 * pi * _mockHash(k * 4.4 + r);
+        // Turn the middle round the normal.
+        final bx = ay * cz - az * cy, by = az * cx - ax * cz, bz = ax * cy - ay * cx;
+        cx = cx * cos(t) + bx * sin(t);
+        cy = cy * cos(t) + by * sin(t);
+        cz = cz * cos(t) + bz * sin(t);
+        for (var i = 0; i < n; i++) {
+          final px = dirs[i * 3], py = dirs[i * 3 + 1], pz = dirs[i * 3 + 2];
+          final along = px * cx + py * cy + pz * cz;
+          if (along < 0.2) continue;
+          final d = (px * ax + py * ay + pz * az).abs();
+          final h = (1 - d / 0.17).clamp(0.0, 1.0);
+          final end = min(1.0, (along - 0.2) * 2.2);
+          heat[i] = max(heat[i], h * h * (3 - 2 * h) * end);
+        }
+      }
+      return heat;
+    }(),
+];
+
+void _paintMockBrute(
+  Canvas c,
+  EnemyPalette pal,
+  int which, {
+  required double time,
+  required double seed,
+  required double charge,
+  required double facing,
+}) {
+  final breath = 0.85 + 0.15 * sin(time * 1.7 + seed);
+  final fine = debugBruteLook != 1;
+  if (debugBruteLook != 3) {
+    c.save();
+    c.rotate(facing);
+    _backlight(c, pal, 1.3 + 0.12 * charge, 1.02 + 0.12 * charge, 0.8 + 0.4 * charge);
+    c.restore();
+  }
+  meshBatch
+    ..add(
+      fine ? _boulders[which] : _bombs[which],
+      _rot,
+      pal,
+      inset: 0,
+      seamAlpha: 0,
+      lit: debugBruteLook == 3 ? 0.2 : 0.12,
+      rimGlow: 0,
+      gloss: 0,
+      dark: 0.9,
+      vertexHeat: switch (debugBruteLook) {
+        1 => _bombSpots[which],
+        2 => _boulderPores[which],
+        _ => _boulderRifts[which],
+      },
+      heatGlow: (debugBruteLook == 1 ? 0.9 : 1.25) * breath + 0.9 * charge,
+    )
+    ..flush(c);
+}
