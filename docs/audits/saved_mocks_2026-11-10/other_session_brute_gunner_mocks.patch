+// MOCK (2026-11-10): the gunner's form, to judge. 0 = the Singularity;
+// 1 the Binary; 2 the Pulsar.
+int debugGunnerLook = 0;
+
+/// Matter pulled from the big star to the small: (phase, lateral, rate).
+final List<(double, double, double)> _streamGrains = () {
+  final rng = Random(81);
+  return [
+    for (var i = 0; i < 240; i++)
+      (
+        rng.nextDouble(),
+        rng.nextDouble() + rng.nextDouble() - 1,
+        0.75 + rng.nextDouble() * 0.5,
+      ),
+  ];
+}();
+
+/// The big star's boiling surface: (angle, lift, rate).
+final List<(double, double, double)> _donorMotes = () {
+  final rng = Random(82);
+  return [
+    for (var i = 0; i < 90; i++)
+      (
+        rng.nextDouble() * 2 * pi,
+        rng.nextDouble(),
+        0.3 + rng.nextDouble() * 0.4,
+      ),
+  ];
+}();
+
+void _paintBinary(
+  Canvas c,
+  EnemyPalette pal,
+  double time,
+  double seed,
+  double spin,
+  bool reduceGlows,
+) {
+  if (!reduceGlows) _circle(c, pal.glow, 2.7);
+  final th = time * 0.5 * spin + seed;
+  const tilt = 0.55;
+  const a1 = 0.55, a2 = 0.85, rDonor = 0.5;
+  final ax = cos(th), ay = sin(th);
+  // (along the pair, across it) in the orbit's plane → the screen.
+  Offset at(double u, double v) =>
+      Offset(u * ax - v * ay, (u * ay + v * ax) * tilt);
+  final donor = at(-a1, 0), small = at(a2, 0);
+  final donorNear = -a1 * ay > a2 * ay;
+
+  void paintDonor() {
+    // A big soft star, not a ball: light all the way out, its limb boiling.
+    c.save();
+    c.translate(donor.dx, donor.dy);
+    c.scale(1.4);
+    _circle(c, pal.glow, 1, 1);
+    c.restore();
+    _sparkAt(c, pal, donor, 0.78, 0.8);
+  }
+
+  void paintSmall() {
+    _sparkAt(c, pal, small, 0.42);
+    _sparkAt(c, pal, small, 0.16);
+  }
+
+  _grainReset();
+  // The big star's surface boils off in motes that fall back.
+  for (final (a, lift, rate) in _donorMotes) {
+    final u = _frac(time * rate + lift);
+    final rr = rDonor * (0.8 + 0.45 * sin(u * pi));
+    final p = donor + Offset(cos(a + th * 0.3), sin(a + th * 0.3)) * rr;
+    _grainAdd(u < 0.5 ? 1 : 2, p.dx, p.dy);
+  }
+  // The stream: from the near point of the big star, curling in round the
+  // small one and falling into it.
+  const l1 = -a1 + rDonor * 0.95;
+  const r0 = a2 - l1;
+  for (final (ph, lat, rate) in _streamGrains) {
+    final s = _frac(time * 0.32 * rate * spin + ph);
+    final phi = pi - s * 1.75 * pi;
+    final r = r0 * pow(1 - s, 1.25) + 0.05;
+    final spread = lat * (0.04 + 0.1 * sin(s * pi));
+    final u = a2 + (r + spread) * cos(phi);
+    final v = (r + spread) * sin(phi);
+    final p = at(u, v);
+    _grainAdd(s < 0.35 ? 2 : (s < 0.75 ? 1 : 0), p.dx, p.dy);
+  }
+  if (!donorNear) paintDonor();
+  if (donorNear) paintSmall();
+  _grainDraw(
+    c,
+    2,
+    0.045,
+    Color.lerp(pal.essence, pal.ink, 0.3)!.withValues(alpha: 0.7),
+  );
+  _grainDraw(c, 1, 0.05, pal.essence.withValues(alpha: 0.9));
+  _grainDraw(c, 0, 0.055, pal.hot);
+  if (donorNear) paintDonor();
+  if (!donorNear) paintSmall();
+}
+
+/// Jet grains: (phase, lateral, rate).
+final List<(double, double, double)> _jetGrains = () {
+  final rng = Random(91);
+  return [
+    for (var i = 0; i < 300; i++)
+      (
+        rng.nextDouble(),
+        rng.nextDouble() + rng.nextDouble() - 1,
+        0.85 + rng.nextDouble() * 0.3,
+      ),
+  ];
+}();
+
+void _paintPulsar(
+  Canvas c,
+  EnemyPalette pal,
+  double time,
+  double seed,
+  double spin,
+  bool reduceGlows,
+) {
+  if (!reduceGlows) _circle(c, pal.glow, 2.4);
+  const beta = 1.25, tiltX = 0.35;
+  const life = 2.2;
+  final sb = sin(beta), cb = cos(beta), st = sin(tiltX), ct = cos(tiltX);
+  (double, double, double) axis(double t) {
+    final psi = t * 1.15 * spin + seed;
+    final x = sb * cos(psi), y = sb * sin(psi), z = cb;
+    return (x, y * ct - z * st, y * st + z * ct);
+  }
+
+  _grainReset();
+  for (var i = 0; i < _jetGrains.length; i++) {
+    final (ph, lat, rate) = _jetGrains[i];
+    final sign = i.isEven ? 1.0 : -1.0;
+    final u = _frac(time / life * rate + ph);
+    final (dx, dy, _) = axis(time - u * life);
+    final d = 0.22 + u * 2.1;
+    final px = -dy, py = dx;
+    final w = lat * (0.03 + 0.2 * u);
+    _grainAdd(
+      u < 0.12 ? 0 : (u < 0.38 ? 1 : (u < 0.7 ? 2 : 3)),
+      sign * d * dx + px * w,
+      sign * d * dy + py * w,
+    );
+  }
+  _grainDraw(
+    c,
+    3,
+    0.035,
+    Color.lerp(pal.essence, pal.ink, 0.45)!.withValues(alpha: 0.5),
+  );
+  _grainDraw(c, 2, 0.045, pal.essence.withValues(alpha: 0.7));
+  _grainDraw(c, 1, 0.055, pal.essence);
+  _grainDraw(c, 0, 0.065, pal.hot);
+  // The star flares as a beam sweeps across us.
+  final (_, _, z) = axis(time);
+  final flare = pow(max(0.0, z.abs() - 0.3) / 0.32, 4).toDouble();
+  _sparkAt(c, pal, Offset.zero, 0.42 + 0.55 * flare);
+  _sparkAt(c, pal, Offset.zero, 0.2);
+}
